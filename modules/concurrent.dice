(slot concurrent
  (before engine driver runtime)
  (consumes
    (CAPTURE_EVENT EVENT_CONCURRENT_ATTACH)
    (CAPTURE_EVENT EVENT_CONCURRENT_DETACH)
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT)
    (CHAIN_INGRESS_AFTER ANY_EVENT)
    (CHAIN_INGRESS_BEFORE ANY_EVENT)
    (CHAIN_INGRESS_EVENT ANY_EVENT EVENT_CONCURRENT_ATTACH
      EVENT_CONCURRENT_DETACH))
  (produces
    (CHAIN_INGRESS_AFTER EVENT_CONCURRENT_ATTACH)
    (CHAIN_INGRESS_BEFORE EVENT_CONCURRENT_DETACH)
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)
    (INTERCEPT_EVENT EVENT_CONCURRENT_ATTACH EVENT_CONCURRENT_DETACH)))
