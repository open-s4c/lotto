(slot evec
  (after blocking clock join mutex rwlock)
  (consumes
    (CAPTURE_EVENT EVENT_EVEC_MOVE)
    (CAPTURE_EVENT EVENT_EVEC_WAKE)
    (CAPTURE_EVENT EVENT_EVEC_CANCEL)
    (CAPTURE_EVENT EVENT_EVEC_TIMED_WAIT)
    (CAPTURE_EVENT EVENT_EVEC_WAIT)
    (CAPTURE_EVENT EVENT_EVEC_PREPARE)
    (CAPTURE_BEFORE EVENT_COND_BROADCAST EVENT_COND_SIGNAL
      EVENT_COND_TIMEDWAIT EVENT_COND_WAIT)
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (produces
    (CHAIN_INGRESS_EVENT EVENT_EVEC_PREPARE EVENT_EVEC_TIMED_WAIT
      EVENT_EVEC_WAIT EVENT_EVEC_WAKE EVENT_MUTEX_ACQUIRE EVENT_MUTEX_RELEASE)
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)
    (INTERCEPT_EVENT EVENT_EVEC_CANCEL EVENT_EVEC_MOVE EVENT_EVEC_PREPARE
      EVENT_EVEC_TIMED_WAIT EVENT_EVEC_WAIT EVENT_EVEC_WAKE)))
