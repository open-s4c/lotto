(slot ghost
  (before engine driver runtime)
  (after concurrent)
  (consumes
    (CAPTURE_EVENT EVENT_GHOST_END EVENT_GHOST_START)
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT)
    (CHAIN_INGRESS_AFTER ANY_EVENT)
    (CHAIN_INGRESS_BEFORE ANY_EVENT)
    (CHAIN_INGRESS_EVENT ANY_EVENT EVENT_GHOST_END EVENT_GHOST_START))
  (produces
    (CHAIN_INGRESS_EVENT EVENT_GHOST_END EVENT_GHOST_START)
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)
    (INTERCEPT_EVENT EVENT_GHOST_END EVENT_GHOST_START)))
