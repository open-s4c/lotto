(slot mutex
  (after blocking clock join)
  (consumes
    (CAPTURE_EVENT EVENT_MUTEX_RELEASE)
    (CAPTURE_EVENT EVENT_MUTEX_TRYACQUIRE)
    (CAPTURE_EVENT EVENT_MUTEX_ACQUIRE)
    (CAPTURE_BEFORE EVENT_MUTEX_LOCK EVENT_MUTEX_TIMEDLOCK
      EVENT_MUTEX_TRYLOCK EVENT_MUTEX_UNLOCK)
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT)
    (CHAIN_LOTTO_TRAP EVENT_MUTEX_TRYACQUIRE))
  (produces
    (CHAIN_INGRESS_EVENT EVENT_MUTEX_ACQUIRE EVENT_MUTEX_RELEASE
      EVENT_MUTEX_TRYACQUIRE)
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)
    (INTERCEPT_EVENT EVENT_MUTEX_ACQUIRE EVENT_MUTEX_RELEASE
      EVENT_MUTEX_TRYACQUIRE)))
