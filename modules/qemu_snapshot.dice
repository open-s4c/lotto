(slot qemu_snapshot
  (after blocking clock join mutex rwlock evec poll timeout cxa impasse
         region_preemption region_filter filtering available watchdog
         busyabort ichpt race memaccess yield terminate priority task_velocity
         order rusty bias pos pct deadlock enforce inactivity autocept time
         sleep random tsan drum debug explore stress trace inflex fork malloc
         user_mempool user_mempool-memmgr_user uafcheck
         uafcheck-memmgr_runtime uafcheck-memmgr_user leakcheck
         leakcheck-memmgr_user leakcheck-memmgr_runtime qemu qemu_gdb
         qemu_profile)
  (consumes
    (CAPTURE_EVENT EVENT_QEMU_SNAPSHOT_DONE)
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT)
    (CHAIN_LOTTO_TRAP EVENT_QEMU_SNAPSHOT_REQUEST)
    (CHAIN_QEMU_CONTROL EVENT_QEMU_FINI EVENT_QEMU_INIT))
  (produces
    (CHAIN_INGRESS_EVENT EVENT_QEMU_SNAPSHOT_DONE)
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)
    (INTERCEPT_EVENT EVENT_QEMU_SNAPSHOT_DONE)))
