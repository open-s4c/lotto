(slot rwlock
  (after blocking clock join mutex)
  (consumes
    (CAPTURE_AFTER EVENT_RWLOCK_TRYRDLOCK EVENT_RWLOCK_TRYWRLOCK)
    (CAPTURE_BEFORE EVENT_RWLOCK_RDLOCK EVENT_RWLOCK_TIMEDRDLOCK
      EVENT_RWLOCK_TIMEDWRLOCK EVENT_RWLOCK_TRYRDLOCK EVENT_RWLOCK_TRYWRLOCK
      EVENT_RWLOCK_UNLOCK EVENT_RWLOCK_WRLOCK)
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (produces
    (CHAIN_INGRESS_EVENT EVENT_RWLOCK_RDLOCK EVENT_RWLOCK_TIMEDRDLOCK
      EVENT_RWLOCK_TIMEDWRLOCK EVENT_RWLOCK_TRYRDLOCK EVENT_RWLOCK_TRYWRLOCK
      EVENT_RWLOCK_UNLOCK EVENT_RWLOCK_WRLOCK)
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)))
