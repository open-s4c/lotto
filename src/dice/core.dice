(slot engine
  (after concurrent ghost)
  (before driver runtime)
  (consumes
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT EVENT_DICE_READY))
  (produces
    (CAPTURE_EVENT ANY_EVENT)
    (CHAIN_INGRESS_AFTER ANY_EVENT)
    (CHAIN_INGRESS_BEFORE ANY_EVENT)
    (CHAIN_INGRESS_EVENT ANY_EVENT)
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)
    (CHAIN_SEQUENCER_CAPTURE ANY_EVENT)
    (CHAIN_SEQUENCER_RESUME ANY_EVENT)
    (INTERCEPT_EVENT ANY_EVENT)))
(slot driver
  (after engine)
  (before runtime)
  (consumes
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (produces
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)))
(slot runtime
  (after engine driver)
  (consumes
    (CAPTURE_EVENT EVENT_SELF_WAIT)
    (CHAIN_DICE_CONTROL EVENT_DICE_INIT)
    (CHAIN_INGRESS_AFTER ANY_EVENT)
    (CHAIN_INGRESS_BEFORE ANY_EVENT)
    (CHAIN_INGRESS_EVENT ANY_EVENT))
  (produces
    (CAPTURE_EVENT ANY_EVENT)
    (CHAIN_INGRESS_AFTER ANY_EVENT)
    (CHAIN_INGRESS_BEFORE ANY_EVENT)
    (CHAIN_INGRESS_EVENT ANY_EVENT)
    (CHAIN_LOTTO_CONTROL ANY_EVENT)
    (CHAIN_LOTTO_DEFAULT ANY_EVENT)
    (CHAIN_SEQUENCER_CAPTURE ANY_EVENT)
    (CHAIN_SEQUENCER_RESUME ANY_EVENT)
    (INTERCEPT_AFTER EVENT_PTHREAD_DETACH)
    (INTERCEPT_BEFORE EVENT_PTHREAD_DETACH)
    (INTERCEPT_EVENT ANY_EVENT)))

; Generic thread forwarding runs after specialized join and mutex subscribers.
(slot threads
  (consumes
    (CAPTURE_AFTER EVENT_THREAD_CREATE EVENT_THREAD_JOIN)
    (CAPTURE_BEFORE EVENT_PTHREAD_DETACH EVENT_THREAD_CREATE EVENT_THREAD_JOIN)
    (CAPTURE_EVENT EVENT_SELF_INIT EVENT_THREAD_EXIT EVENT_THREAD_START))
  (produces
    (CHAIN_INGRESS_EVENT EVENT_TASK_INIT EVENT_TASK_FINI)
    (CHAIN_INGRESS_BEFORE EVENT_TASK_CREATE EVENT_TASK_JOIN EVENT_TASK_DETACH)
    (CHAIN_INGRESS_AFTER EVENT_TASK_CREATE EVENT_TASK_JOIN)
    (INTERCEPT_BEFORE EVENT_PTHREAD_DETACH)
    (INTERCEPT_AFTER EVENT_PTHREAD_DETACH)))
